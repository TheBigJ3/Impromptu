{
  "name": "Impromptu",
  "description": "Harness the power of AI with full customization allowing you to increase production in infinite ways!",
  "version": "1.0.0",
  "manifest_version": 3,

  "icons": {
    "16": "/Logo/Icon16.png",
    "32": "/Logo/Icon32.png",
    "48": "/Logo/Icon48.png",
    "128": "/Logo/Icon128.png"
  },


  "action": {},

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

"permissions": ["scripting", "storage", "tabs", "activeTab"],


  "web_accessible_resources": [
    {
      "resources": ["Icons/*"],
      "matches": ["<all_urls>"]
    }
  ],

 "host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Watcher.js"],
      "run_at": "document_idle"
    }
  ]
  
}
